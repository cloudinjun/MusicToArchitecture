  "experiment_id": "audio-saturation-corpus-2026-08-30",
  "purpose": "Test whether the current audio normalisation, ten-dimension Shared Score, and v3 datum/model chain collapse stylistically different real recordings onto range endpoints or repeated outputs.",
  "excerpt": {
    "strategy": "center_window",
    "duration_seconds": 30.0,
    "reason": "A fixed window removes track-duration as a confound and matches the duration of the shortest legitimate source recordings. This evaluates calibration, not full-song sectional form."
  },
  "saturation_definition": {
    "near_endpoint_epsilon": 0.02,
    "exact_endpoint": "normalised value equals 0.0 or 1.0 within 1e-9",
    "near_endpoint": "normalised value is within 0.02 of either endpoint"
  },
  "acceptance": {
    "pipeline_success_rate_min": 1.0,
    "feature_exact_endpoint_rate_max": 0.05,
    "feature_near_endpoint_rate_max": 0.15,
    "single_feature_near_endpoint_rate_max": 0.25,
    "score_signature_collision_rate_max": 0.0,
    "model_signature_collision_rate_max": 0.0,
    "variable_coverage_min": 1.0
  },
