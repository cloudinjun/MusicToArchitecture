# Local tools and environments
/.claude/
/.playwright-cli/
/.pytest_cache/
/.venv/
**/__pycache__/
*.py[cod]
.coverage
htmlcov/

# Local configuration and secrets
**/.env
**/.env.*
!**/.env.example

# Web dependencies and build output
/web/node_modules/
/web/.next/
/web/.vinext/
/web/dist/
/web/.wrangler/
/web/tsconfig.tsbuildinfo

# Regenerable runtime and research output
/runtime/inbox/
/blender/generated/
/artifacts/drawings/
/artifacts/native_models/generated/
/artifacts/v3_runs/
/artifacts/web_runs/
/artifacts/inspector/
/artifacts/audio_saturation/*/tracks/
/artifacts/style_evidence/solid/
/.codex_tmp/

# Keep the visual-audit corpus locally. Publish only the compact review surface:
# summaries, comparison cards, and per-track geometry/parity measurements.
/artifacts/visual_audit/**
!/artifacts/visual_audit/README.md
!/artifacts/visual_audit/2026-09-03/
!/artifacts/visual_audit/2026-09-03/architecture_findings.md
!/artifacts/visual_audit/2026-09-03/case_results.csv
!/artifacts/visual_audit/2026-09-03/corpus_table.md
!/artifacts/visual_audit/2026-09-03/issue_catalog.json
!/artifacts/visual_audit/2026-09-03/source_comparison.json
!/artifacts/visual_audit/2026-09-03/stair_opening_comparison.jpg
!/artifacts/visual_audit/2026-09-03/targeted_test_results.txt
!/artifacts/visual_audit/2026-09-03/verification.json
!/artifacts/visual_audit/2026-09-03/baseline-frozen/
!/artifacts/visual_audit/2026-09-03/baseline-frozen/measurement_summary.json
!/artifacts/visual_audit/2026-09-03/verified-frozen/
!/artifacts/visual_audit/2026-09-03/verified-frozen/glb_parity_report.json
!/artifacts/visual_audit/2026-09-03/verified-frozen/measurement_summary.json
!/artifacts/visual_audit/2026-09-03/verified-frozen/visual_review.json
!/artifacts/visual_audit/2026-09-03/verified-frozen/review_cards/
!/artifacts/visual_audit/2026-09-03/verified-frozen/review_cards/*.jpg
!/artifacts/visual_audit/2026-09-03/verified-frozen/detail_cards/
!/artifacts/visual_audit/2026-09-03/verified-frozen/detail_cards/*.jpg
!/artifacts/visual_audit/2026-09-03/verified-frozen/tracks/
!/artifacts/visual_audit/2026-09-03/verified-frozen/tracks/*/
!/artifacts/visual_audit/2026-09-03/verified-frozen/tracks/*/geometry_measurements.json
!/artifacts/visual_audit/2026-09-03/verified-frozen/tracks/*/glb_parity.json

# Keep only stable deployment aliases. Immutable versions live in
# artifacts/model_versions/archive/ and retain their content hashes.
/web/public/models/generated/*
!/web/public/models/generated/latest-v2.glb
!/web/public/models/generated/latest-v2.manifest.json
!/web/public/models/generated/latest-v3.glb
!/web/public/models/generated/latest-v3.manifest.json

# Blender's automatic backup files are local recovery files.
*.blend1
